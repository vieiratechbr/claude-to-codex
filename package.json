{
  "name": "claude-to-codex",
  "version": "0.1.0",
  "description": "Converta extensões do Claude Code e instale no Codex local.",
  "private": true,
  "author": "vieiratechbr",
  "license": "MIT",
  "repository": "https://github.com/vieiratechbr/claude-to-codex.git",
  "type": "module",
  "main": "dist/main/index.cjs",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "test:desktop": "playwright test",
    "test:packaged": "node scripts/check-packaged.mjs",
    "test:codex-local": "node scripts/check-local-codex.mjs",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "overrides": {
    "@electron/get": "5.1.0"
  }
}
